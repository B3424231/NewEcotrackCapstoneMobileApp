{
  "expo": {
    "name": "EcoTrack",
    "slug": "ecotrackapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ecotrack-app-icon.png",
    "scheme": "ecotrackapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ecotrack-app-icon.png",
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow EcoTrack to read your connected Wi-Fi name when configuring an AC controller."
      }
    },
    "android": {
      "package": "com.ecotrack.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/ecotrack-launcher-foreground.png",
        "monochromeImage": "./assets/images/ecotrack-launcher-foreground.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/ecotrack-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/ecotrack-notification-icon.png",
          "color": "#047857"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow EcoTrack to take profile and maintenance proof photos.",
          "photosPermission": "Allow EcoTrack to select profile and maintenance proof photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b291d",
          "image": "./assets/images/ecoTrack.png",
          "imageWidth": 120
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow EcoTrack to connect to nearby ESP32-S3 AC Controller nodes over Bluetooth."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc84c899-5b2f-428a-b534-9e5b7e7efd0f"
      }
    },
    "owner": "niggerrey"
  }
}
